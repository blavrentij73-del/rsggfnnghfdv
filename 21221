function loadGame(){
  let raw=null;
  try{ raw=localStorage.getItem("derzhavy_save"); }catch(e){ return false; }
  if(!raw) return false;
  let data;
  try{ data=JSON.parse(raw); }catch(e){ return false; }
  if(!data||!data.seed||!data.provs) return false;
  newGame(data.seed, true);
  try{
    data.provs.forEach((p,i)=>{
      const d=S.provs[i];
      if(!d) return;
      d.owner=p.owner; d.dev=p.dev; d.b=p.b; d.build=p.build; d.siege=p.siege||0; d.occupiedBy=p.occupiedBy; d.unrest=p.unrest||0; d.rebel=!!p.rebel;
    });
    data.nations.forEach((n,i)=>{
      const t=S.nations[i];
      if(!t) return;
      t.gold=n.gold; t.stability=n.stability; t.prestige=n.prestige; t.manpower=n.manpower;
      t.armies=n.armies; t.allies=n.allies||[]; t.dead=!!n.dead; t.tech=n.tech||t.tech; t.rp=n.rp||0; t.generals=n.generals||t.generals; t.ships=n.ships||0; if(n.port!=null) t.port=n.port;
    });
    S.date=data.date; S.playerId=data.playerId; S.nextArmy=data.nextArmy;
    S.wars=data.wars||{}; S.truces=data.truces||{}; S.rel=data.rel||{};
    S.log=data.log||[];
    S.stats=data.stats||{battles:0,peaces:0,buildings:0,unlocked:{}};
    S.ended=data.ended||null;
    S.sel={prov:S.nations[S.playerId].capital,army:null};
    bakeDirty=true; ovDirty=true;
    renderPanel(); updateTop();
    return true;
  }catch(e){ newGame(); return false; }
}

function provAt(ev){
  const r=mapCv.getBoundingClientRect();
  const v=mapView(r.width,r.height);
  const x=((ev.clientX-r.left)-v.x)/v.s;
  const y=((ev.clientY-r.top)-v.y)/v.s;
  if(x<0||y<0||x>=RW||y>=RH) return null;
  return siteProv[cell[(y|0)*RW+(x|0)]];
}

function init(){
  mapCv=document.getElementById("map");
  mctx=mapCv.getContext("2d");
  resizeCanvas();
  window.addEventListener("resize",resizeCanvas);
  if(!loadGame()) newGame();

  document.addEventListener("click",ev=>{
    const t=ev.target.closest("[data-act]");
    if(!t) return;
    const parts=t.dataset.act.split(":");
    const act=parts[0];
    if(act==="speed"){ S.speed=Number(parts[1]); if(S.speed>0) S.acc=0; updateTop(); }
    else if(act==="tab"){ S.tab=parts[1]; renderPanel(); }
    else if(act==="tech"){ buyTech(parts[1]); }
    else if(act==="pacify"){ pacifyProv(Number(parts[1])); }
    else if(act==="assault"){ assault(Number(parts[1])); }
    else if(act==="ship"){ buildShip(); }
    else if(act==="save"){ saveSlot(Number(parts[1])); }
    else if(act==="load"){ loadSlot(Number(parts[1])); }
    else if(act==="gen"){ assignGeneral(Number(parts[1])); }
    else if(act==="recall"){ recallGeneral(Number(parts[1])); }
    else if(act==="split"){ splitArmy(Number(parts[1])); }
    else if(act==="merge"){ mergeArmies(Number(parts[1])); }
    else if(act==="fleet"){ setFleetStance(parts[1]); }
    else if(act==="autot"){ toggleAutoArmy(Number(parts[1])); }
    else if(act==="focus"){
      const pid=Number(parts[1]);
      if(pid>=0&&G.provs[pid]){
        VIEW.cx=G.provs[pid].x; VIEW.cy=G.provs[pid].y;
        VIEW.zoom=Math.max(VIEW.zoom,2.4);
        S.sel.prov=pid; S.tab="prov"; ovDirty=true; renderPanel();
      }
    }
    else if(act==="zoom"){
      const rr=mapCv.getBoundingClientRect();
      if(parts[1]==="in") zoomAt(rr.width/2,rr.height/2,rr.width,rr.height,1.3);
      else if(parts[1]==="out") zoomAt(rr.width/2,rr.height/2,rr.width,rr.height,1/1.3);
      else resetView();
    }
    else if(act==="build"){ buildIn(Number(parts[1]),parts[2]); }
    else if(act==="improve"){ improveProv(Number(parts[1])); }
    else if(act==="recruit"){ recruitType(parts[1]||"inf"); }
    else if(act==="festival"){ festival(); }
    else if(act==="selarmy"){ selectArmy(Number(parts[1])); }
    else if(act==="war"){ declareWar(Number(parts[1])); }
    else if(act==="peace"){ doPeace(S.playerId,Number(parts[1])); }
    else if(act==="gift"){ sendGift(Number(parts[1])); }
    else if(act==="ally"){ makeAlly(Number(parts[1])); }
    else if(act==="newgame"){
      openModal("Новая партия","Начать новую летопись? Текущая партия будет заменена (сохранение перезапишется при следующем январе).",[
        {label:"Начать заново", gold:true, fn:()=>{ localStorage.removeItem("derzhavy_save"); newGame(); }},
        {label:"Отмена", fn:()=>{}}
      ]);
    }
  });

  let drag=null, dragMoved=false;
  mapCv.addEventListener("pointerdown",ev=>{
    if(ev.button!==0) return;
    drag={x:ev.clientX,y:ev.clientY,cx:VIEW.cx,cy:VIEW.cy,moved:false};
    try{ mapCv.setPointerCapture(ev.pointerId); }catch(e){}
  });
  mapCv.addEventListener("pointermove",ev=>{
    if(!drag) return;
    const r=mapCv.getBoundingClientRect();
    const v=mapView(r.width,r.height);
    const dx=ev.clientX-drag.x, dy=ev.clientY-drag.y;
    if(Math.abs(dx)+Math.abs(dy)>4) drag.moved=true;
    if(drag.moved){
      VIEW.cx=drag.cx-dx/v.s;
      VIEW.cy=drag.cy-dy/v.s;
      clampView(r.width,r.height);
      document.getElementById("tip").classList.add("hidden");
    }
  });
  mapCv.addEventListener("pointerup",()=>{
    if(drag){ dragMoved=drag.moved; drag=null; }
  });
  mapCv.addEventListener("pointercancel",()=>{ drag=null; });
  mapCv.addEventListener("wheel",ev=>{
    ev.preventDefault();
    const r=mapCv.getBoundingClientRect();
    zoomAt(ev.clientX-r.left, ev.clientY-r.top, r.width, r.height, ev.deltaY<0?1.18:1/1.18);
  },{passive:false});
  mapCv.addEventListener("dblclick",ev=>{
    ev.preventDefault();
    const rr=mapCv.getBoundingClientRect();
    zoomAt(ev.clientX-rr.left, ev.clientY-rr.top, rr.width, rr.height, 1.6);
  });
  mapCv.addEventListener("contextmenu",ev=>{
    ev.preventDefault();
    const rr=mapCv.getBoundingClientRect();
    zoomAt(ev.clientX-rr.left, ev.clientY-rr.top, rr.width, rr.height, 1/1.6);
  });

  mapCv.addEventListener("click",ev=>{
    if(dragMoved){ dragMoved=false; return; }
    const rr2=mapCv.getBoundingClientRect();
    const vv2=mapView(rr2.width,rr2.height);
    let hitArmy=null;
    for(const nn of S.nations){
      if(nn.id!==S.playerId) continue;
      for(const aa of nn.armies){
        const pr2=G.provs[aa.loc];
        const ax=vv2.x+pr2.x*vv2.s, ay=vv2.y+pr2.y*vv2.s;
        const px=ev.clientX-rr2.left, py=ev.clientY-rr2.top;
        if((px-ax)*(px-ax)+(py-ay)*(py-ay)<18*18){ hitArmy=aa; break; }
      }
      if(hitArmy) break;
    }
    if(hitArmy){ S.sel.army=hitArmy.id; S.sel.prov=hitArmy.loc; S.tab="prov"; ovDirty=true; renderPanel(); return; }
    const pid=provAt(ev);
    if(pid==null||pid<0){
      S.sel={prov:null,army:null}; ovDirty=true; S.tab="prov"; renderPanel(); return;
    }
    if(S.sel.army!=null){
      const f=findArmy(S.sel.army);
      if(f&&f.nation.id===S.playerId&&(G.adj[f.army.loc].includes(pid)||(G.provs[f.army.loc].coastal&&G.provs[pid].coastal))){
        moveArmy(f.nation,f.army,pid,false);
        S.sel.prov=pid; ovDirty=true; updateTop(); renderPanel(); return;
      }
      if(f&&f.army.loc===pid){ S.sel.army=null; }
    }
    S.sel.prov=pid; S.tab="prov"; ovDirty=true; renderPanel();
  });

  mapCv.addEventListener("mousemove",ev=>{
    const tip=document.getElementById("tip");
    const pid=provAt(ev);
    if(pid==null||pid<0){ tip.classList.add("hidden"); S.hover=null; return; }
    const d=S.provs[pid], p=G.provs[pid];
    const own=S.nations[d.owner];
    const occ=d.occupiedBy!=null?(" · окк. "+S.nations[d.occupiedBy].short):"";
    tip.textContent=p.name+" — "+own.short+occ;
    tip.classList.remove("hidden");
    const wrap=mapCv.parentElement.getBoundingClientRect();
    tip.style.left=(ev.clientX-wrap.left)+"px";
    tip.style.top=(ev.clientY-wrap.top)+"px";
    S.hover=pid;
  });
  mapCv.addEventListener("mouseleave",()=>{document.getElementById("tip").classList.add("hidden");});

  document.addEventListener("keydown",ev=>{
    if(document.getElementById("modal").classList.contains("hidden")===false){
      if(ev.key==="Escape") closeModal();
      return;
    }
    if(ev.code==="Space"){ ev.preventDefault(); S.speed=S.speed===0?2:0; S.acc=0; updateTop(); }
    else if(ev.key==="1"){ S.speed=1; updateTop(); }
    else if(ev.key==="2"){ S.speed=2; updateTop(); }
    else if(ev.key==="3"){ S.speed=3; updateTop(); }
    else if(ev.key==="0"){ S.speed=0; updateTop(); }
    else if(ev.key==="Escape"){ S.sel.army=null; ovDirty=true; renderPanel(); }
  });

  document.getElementById("legend").textContent="Колесо — масштаб, перетаскивание — сдвиг · щёлкните провинцию или значок армии, чтобы выбрать армию · затем щёлкните соседнюю провинцию для похода · Esc — снять выбор · пробел — пауза · 1–3 — скорость · границы: Natural Earth (de facto)";
  requestAnimationFrame(frame);
}

function frame(ts){
  requestAnimationFrame(frame);
  if(!S) return;
  if(!lastTs) lastTs=ts;
  const dt=ts-lastTs;
  lastTs=ts;
  if(S.speed>0&&!S.ended){
    S.acc+=dt;
    const interval=[Infinity,1100,520,190][S.speed];
    let guard=0;
    while(S.acc>interval&&guard++<4){ S.acc-=interval; tick(); }
  }
  drawMap();
}

init();
</script>
</body>
</html>
