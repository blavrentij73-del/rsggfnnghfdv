function processSieges(){
  const idx=new Map();
  for(const n of S.nations) for(const a of n.armies){
    let arr=idx.get(a.loc);
    if(!arr){ arr=[]; idx.set(a.loc,arr); }
    arr.push({nation:n,army:a});
  }
  for(const p of G.provs){
    const d=S.provs[p.id];
    if(d.occupiedBy!=null) continue;
    const here=idx.get(p.id)||[];
    if(!here.length){ if(d.siege>0) d.siege=Math.max(0,d.siege-12); continue; }
    const ownerHere=here.some(h=>h.nation.id===d.owner);
    if(ownerHere){ if(d.siege>0) d.siege=Math.max(0,d.siege-25); continue; }
    const foes=here.filter(h=>isWar(h.nation.id,d.owner)&&!h.nation.dead&&!h.nation.isRebel);
    if(!foes.length) continue;
    const units=foes.reduce((s,h)=>s+siegePower(h.army),0);
    d.siege=clamp(d.siege+(units*(1+0.05*((foes[0].nation.tech&&foes[0].nation.tech.mil)||0)))/(1+d.b.fort*0.7),0,100);
    if(d.siege>=100) occupy(p.id,foes[0].nation.id,false);
  }
}

function zoneOfXY(x,y){
  const zs=G.seaZones;
  if(!zs) return 0;
  const cx=Math.floor(x/200), cy=Math.floor(y/200);
  return Math.max(0,Math.min(zs.rows-1,cy))*zs.cols+Math.max(0,Math.min(zs.cols-1,cx));
}
function zoneOfProv(pid){ return zoneOfXY(G.provs[pid].x,G.provs[pid].y); }
function zoneDist(a,b){
  const zs=G.seaZones;
  if(!zs) return 99;
  const ax=a%zs.cols, ay=Math.floor(a/zs.cols), bx=b%zs.cols, by=Math.floor(b/zs.cols);
  return Math.abs(ax-bx)+Math.abs(ay-by);
}
function setFleetStance(st){
  const P=S.nations[S.playerId];
  if(!P.fleet) P.fleet={z:(P.port!=null?zoneOfProv(P.port):0), stance:"port", moves:1};
  if(st!=="port"&&(!P.ships||P.port==null)) return toast("Нет флота или порта");
  P.fleet.stance=st;
  renderPanel();
}
function navalTick(){
  const zs=G.seaZones;
  if(!zs) return;
  for(const n of S.nations){ if(!n.fleet) n.fleet={z:(n.port!=null?zoneOfProv(n.port):0), stance:"port", moves:1}; }
  for(const n of S.nations){
    if(n.id===S.playerId||n.isRebel||!n.fleet) continue;
    if(n.fleet.stance==="port"&&(n.ships||0)>0&&Math.random()<0.12){
      const foe=S.nations.find(x=>x.id!==n.id&&!x.dead&&!x.isRebel&&isWar(n.id,x.id));
      if(foe) n.fleet.stance="blockade";
    }
  }
  const cols=zs.cols, rows=zs.rows, water=zs.water;
  const zx=z=>z%cols, zy=z=>Math.floor(z/cols);
  const zid=(x,y)=>y*cols+x;
  for(const d of S.provs) d.block=0;
  const byZone=new Map();
  for(const n of S.nations){
    if(!n.fleet||n.dead||n.isRebel) continue;
    if((n.ships||0)<=0) continue;
    let arr=byZone.get(n.fleet.z);
    if(!arr){ arr=[]; byZone.set(n.fleet.z,arr); }
    arr.push(n);
  }
  for(const entry of byZone.values()){
    for(let i=0;i<entry.length;i++){
      for(let j=i+1;j<entry.length;j++){
        const a=entry[i], b=entry[j];
        if(!isWar(a.id,b.id)) continue;
        const pa=(a.ships||0)*(1+0.08*((a.tech&&a.tech.mil)||0));
        const pb=(b.ships||0)*(1+0.08*((b.tech&&b.tech.mil)||0));
        const tot=pa+pb||1;
        const la=Math.round((a.ships||0)*(pb/tot)*(0.3+Math.random()*0.4));
        const lb=Math.round((b.ships||0)*(pa/tot)*(0.3+Math.random()*0.4));
        a.ships=Math.max(0,(a.ships||0)-la);
        b.ships=Math.max(0,(b.ships||0)-lb);
        if(la||lb) logMsg("Морской бой: "+a.short+" и "+b.short+", потоплено "+la+" и "+lb,"war");
      }
    }
  }
  for(const n of S.nations){
    if(!n.fleet||n.dead||n.isRebel) continue;
    if((n.ships||0)<=0){ n.fleet.stance="port"; n.fleet.moves=1; continue; }
    const home=n.port!=null?zoneOfProv(n.port):null;
    if(n.fleet.stance==="port"){
      if(home!=null) n.fleet.z=home;
      n.fleet.moves=1;
      continue;
    }
    if(n.fleet.stance==="blockade"){
      let best=-1, bd=1e9;
      for(const d of S.provs){
        if(d.owner==null||d.owner===n.id) continue;
        if(!isWar(n.id,d.owner)) continue;
        if(!G.provs[d.id].coastal) continue;
        const z2=zoneOfProv(d.id);
        const dist=zoneDist(n.fleet.z,z2);
        if(dist<bd){ bd=dist; best=z2; }
      }
      if(best<0){ n.fleet.stance="patrol"; }
      else{
        if(best!==n.fleet.z&&n.fleet.moves>0){
          const cx=zx(n.fleet.z), cy=zy(n.fleet.z), tx=zx(best), ty=zy(best);
          const dirs=[];
          if(tx!==cx) dirs.push([Math.sign(tx-cx),0]);
          if(ty!==cy) dirs.push([0,Math.sign(ty-cy)]);
          for(const dir of dirs){
            const sx=cx+dir[0], sy=cy+dir[1];
            if(sx<0||sy<0||sx>=cols||sy>=rows) continue;
            const z2=zid(sx,sy);
            if(!water[z2]) continue;
            n.fleet.z=z2; n.fleet.moves=0; break;
          }
        }
        for(const d of S.provs){
          if(d.owner==null||d.owner===n.id) continue;
          if(!isWar(n.id,d.owner)) continue;
          if(!G.provs[d.id].coastal) continue;
          if(zoneOfProv(d.id)===n.fleet.z) d.block=1;
        }
      }
      continue;
    }
    if(n.fleet.moves>0){
      const cx=zx(n.fleet.z), cy=zy(n.fleet.z);
      const dirs=[[1,0],[-1,0],[0,1],[0,-1]];
      for(let k=0;k<4;k++){
        const dir=dirs[(k+((n.id*7+Math.floor(Math.random()*4))%4))%4];
        const sx=cx+dir[0], sy=cy+dir[1];
        if(sx<0||sy<0||sx>=cols||sy>=rows) continue;
        const z2=zid(sx,sy);
        if(!water[z2]) continue;
        n.fleet.z=z2; n.fleet.moves=0; break;
      }
    }
  }
  for(const d of S.provs){
    if(!d.block) continue;
    d.unrest=clamp((d.unrest||0)+1.2,0,100);
    const owner=S.nations[d.owner];
    if(owner) owner.gold=Math.max(0,owner.gold-0.8);
  }
}
function aiTech(n){
  if(!n.tech) n.tech={eco:0,mil:0,adm:0};
  const keys=["eco","mil","adm"];
  let best=null, bc=1e9;
  for(const k of keys){
    const l=n.tech[k]||0;
    if(l>=5) continue;
    const c=TECH_COST[l];
    if(c<bc){ bc=c; best=k; }
  }
  if(!best||(n.rp||0)<bc) return;
  n.rp-=bc; n.tech[best]=(n.tech[best]||0)+1;
}
function aiRecruit(n){
  if(n.gold<30||n.manpower<2) return;
  n.gold-=30; n.manpower-=2;
  const a=n.armies.find(x=>x.loc===n.capital);
  if(a){ a.units++; if(Math.random()<0.3) a.cav=(a.cav||0)+1; }
  else addArmy(n,n.capital,1);
}
function aiBuild(n){
  const pool=[];
  for(const p of G.provs){
    const d=S.provs[p.id];
    if(d.owner!==n.id||d.build) continue;
    const slots=Object.values(d.b).reduce((a,c)=>a+c,0);
    if(slots<5) pool.push(d);
  }
  if(!pool.length) return;
  const d=pool[Math.floor(Math.random()*pool.length)];
  const keys=["farm","farm","mine","workshop","barracks","fort"];
  const key=keys[Math.floor(Math.random()*keys.length)];
  const b=BUILD[key];
  if(n.gold<b.cost) return;
  n.gold-=b.cost;
  d.build={key,left:2+Math.round(b.cost/45)};
}
function aiDiplomacy(n){
  const neigh=new Set();
  for(let i=0;i<S.provs.length;i++){ if(S.provs[i].owner!==n.id) continue; for(const nb of G.adj[i]) if(S.provs[nb].owner!==n.id) neigh.add(S.provs[nb].owner); }
  const others=S.nations.filter(x=>x.id!==n.id&&!x.dead&&neigh.has(x.id));
  for(const o of others){
    const rel=getRel(n.id,o.id);
    if(rel<0 && Math.random()<0.02) addRel(n.id,o.id,3);
    if(rel>55 && !n.allies.includes(o.id) && Math.random()<0.02){
      if(n.allies.length<2 && o.allies.length<2){ n.allies.push(o.id); o.allies.push(n.id); }
    }
  }
  if(nationUnits(n)===0) return;
  if(S.date.y<2027) return;
  if(S.nations.some(x=>!x.dead&&isWar(n.id,x.id))) return;
  for(const o of others){
    if(isWar(n.id,o.id)||hasTruce(n.id,o.id)||n.allies.includes(o.id)) continue;
    if(o.id===S.playerId){
      const playerBusy=S.nations.some(x=>x.id!==o.id&&!x.dead&&isWar(o.id,x.id));
      if(playerBusy) continue;
    }
    const myPow=nationUnits(n), theirPow=nationUnits(o);
    const aggressive=myPow>=Math.max(2,theirPow*1.35);
    const weakTarget=theirPow<=Math.max(1,nationProvCount(o));
    if(aggressive && weakTarget && Math.random()<0.03){
      startWar(n.id,o.id);
      if(o.id===S.playerId||n.id===S.playerId){
        logMsg("Война: "+n.name+" нападает на "+o.name,"war");
        if(o.id===S.playerId) toast(n.short+" объявил вам войну!");
      }else{
        logMsg("Война: "+n.name+" против "+o.name,"war");
      }
      return;
    }
  }
}
