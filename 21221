      '<div class="sec"><h3>Как играть</h3><div class="muted">Время идёт по месяцам — запустите его кнопкой ▶. Стройте, развивайте провинции, нанимайте полки, заключайте союзы и воюйте. Цель — подчинить большую часть мира.</div></div>';
  }
  const p=G.provs[id], d=S.provs[id], own=S.nations[d.owner];
  const isMine=d.owner===S.playerId;
  const occ=d.occupiedBy!=null?S.nations[d.occupiedBy]:null;
  let h='<div class="sec">';
  h+='<h2 class="prov">'+p.name+'</h2>';
  h+='<div class="muted">'+TERRAIN[p.terrain].n+(p.coastal?' · побережье':'')+' · развитие '+fmt1(d.dev)+' · население '+fmt1(d.pop||0)+' млн</div>';
  h+='</div><div class="sec"><h3>Власть</h3>';
  h+='<div class="row"><span>Держава</span><b style="color:'+own.color+'">'+own.name+'</b></div>';
  if(occ) h+='<div class="row"><span>Оккупирована</span><b style="color:'+occ.color+'">'+occ.name+'</b></div>';
  h+='<div class="row"><span>Доход</span><b>'+fmt1(d.occupiedBy!=null?0:provIncome(id))+'</b></div>';
  const un=Math.round(d.unrest||0);
  if(un>0){
    h+='<div class="row"><span>Недовольство</span><b style="color:'+(un>60?"#de7a6c":un>30?"#e8c987":"#9ed3ab")+'">'+un+'%</b></div>';
    h+='<div class="bar '+(un>60?"red":"")+'"><i style="width:'+un+'%"></i></div>';
  }
  if(isMine&&un>15) h+='<div class="btnrow"><button class="btn small" data-act="pacify:'+id+'" '+(P_gold()>=25?"":"disabled")+'>Умиротворить · 25</button></div>';
  if(d.siege>0){
    h+='<div class="row"><span>Осада</span><b>'+Math.round(d.siege)+'%</b></div>';
    h+='<div class="bar red"><i style="width:'+Math.min(100,d.siege)+'%"></i></div>';
  }
  const here=armiesAt(id);
  if(here.length){
    h+='<div class="row"><span>Войска здесь</span><b>'+here.map(x=>x.army.units+" ("+x.nation.short+")").join(", ")+'</b></div>';
  }
  const myHere=here.filter(x=>x.nation.id===S.playerId);
  if(myHere.length && d.owner!==S.playerId && isWar(S.playerId,d.owner) && d.occupiedBy==null){
    h+='<div class="btnrow"><button class="btn small danger" data-act="assault:'+id+'">Штурм</button></div>';
  }
  h+='</div>';
  h+=countryCard(own,isMine,d);
