    const truce=S.truces[warKey(P.id,own.id)]||0;
    h+='<div class="row"><span>Отношения</span><b style="color:'+(rel>=25?"#7fc187":rel<=-25?"#de7a6c":"#8797a4")+'">'+(rel>0?"+":"")+rel+'</b></div>';
    if(ally) h+='<div class="row"><span>Статус</span><b style="color:#9ed3ab">союзник</b></div>';
    else if(war) h+='<div class="row"><span>Статус</span><b style="color:#e8a49a">война</b></div>';
    else if(truce) h+='<div class="row"><span>Перемирие</span><b>'+truce+' мес.</b></div>';
    h+='<div class="btnrow">';
    if(war){
      h+='<button class="btn small gold" data-act="peace:'+own.id+'">Заключить мир</button>';
    }else{
      h+='<button class="btn small" data-act="gift:'+own.id+'" '+(P.gold>=50?"":"disabled")+'>Подарок · 50</button>';
      h+='<button class="btn small" data-act="ally:'+own.id+'" '+(rel>=40&&!ally?"":"disabled")+'>Союз</button>';
      h+='<button class="btn small danger" data-act="war:'+own.id+'" '+(truce>0?"disabled":"")+'>Война</button>';
    }
