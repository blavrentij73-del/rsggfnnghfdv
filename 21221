        openModal("Предложение мира", other.name+" предлагает прекратить войну. Провинции останутся за теми, кто их занимает.", [
          {label:"Заключить мир", gold:true, fn:()=>doPeace(n.id,other.id)},
          {label:"Продолжать войну", fn:()=>{}}
        ]);
      }
      continue;
    }
    if(Math.random()<0.22) doPeace(ab[0],ab[1]);
  }
}
function aiMove(n){
  const enemies=S.nations.filter(x=>!x.dead&&isWar(n.id,x.id));
  if(!enemies.length){
    for(const a of n.armies){
      if(a.moves<=0||a.loc===n.capital) continue;
      const step=findStep(a.loc, pid=>S.provs[pid].owner===n.id&&S.provs[pid].occupiedBy==null&&nationProvCount(n)>4, pid=>canEnter(n.id,pid));
      if(step!=null&&Math.random()<0.25){ const r=moveArmy(n,a,step,true); if(r) continue; }
    }
    return;
  }
  for(const a of n.armies){
    if(a.moves<=0) continue;
    let step=null;
    for(const e of enemies){
      step=findStep(a.loc, pid=>{
        const d=S.provs[pid];
        return (d.owner===e.id&&d.occupiedBy==null)||d.occupiedBy===e.id;
      }, pid=>canEnter(n.id,pid));
      if(step!=null) break;
    }
    if(step==null) continue;
    moveArmy(n,a,step,true);
  }
}
function autoArmies(){
  const n=S.nations[S.playerId];
  const enemies=S.nations.filter(x=>!x.dead&&isWar(n.id,x.id));
  for(const a of n.armies){
    if(!a.auto||a.moves<=0) continue;
    let step=null;
    if(enemies.length){
      for(const e of enemies){
        step=findStep(a.loc, pid=>{ const d=S.provs[pid]; return (d.owner===e.id&&d.occupiedBy==null)||d.occupiedBy===e.id||d.rebel; }, pid=>canEnter(n.id,pid));
        if(step!=null) break;
      }
    }else{
      if(a.loc!==n.capital) step=findStep(a.loc, pid=>S.provs[pid].owner===n.id&&S.provs[pid].occupiedBy==null, pid=>canEnter(n.id,pid));
    }
    if(step==null) continue;
    moveArmy(n,a,step,true);
  }
}
function toggleAutoArmy(id){
  const f=findArmy(id);
  if(!f) return;
  if(f.nation.id!==S.playerId) return;
  f.army.auto=!f.army.auto;
  renderPanel(); updateTop();
}
function aiTurn(){
  for(const n of S.nations){
    if(n.dead||n.id===S.playerId||n.isRebel) continue;
    const aiCap=2+Math.floor(nationProvCount(n)*0.8); if(n.gold>60&&n.manpower>2&&nationUnits(n)<aiCap&&Math.random()<0.45) aiRecruit(n);
    aiTech(n);
    if((n.ships||0)<6&&n.gold>250&&Math.random()<0.2) buildShipFor(n);
    if(n.gold>110&&Math.random()<0.35) aiBuild(n);
    if(n.gold>300&&Math.random()<0.3){
      const own=S.provs.filter(d=>d.owner===n.id&&d.dev<20);
      if(own.length){ const d=own[Math.floor(Math.random()*own.length)]; n.gold-=65; d.dev=Math.min(20,d.dev+0.5); }
    }
    aiDiplomacy(n);
    aiPeace(n);
    aiMove(n);
  }
}

function tick(){
  if(!S||S.ended) return;
  COUNTS=null;
  computeTrade();
  S.date.m++;
  if(S.date.m>12){S.date.m=1;S.date.y++;}
  for(const n of S.nations){
    if(n.dead||n.isRebel) continue;
    const inc=nationIncome(n), up=upkeep(n);
    n.gold+=inc-up;
    const mm=maxManpower(n);
    n.manpower=Math.min(mm,n.manpower+mm*0.04);
    n.rp=(n.rp||0)+1+Math.sqrt(nationPop(n))*0.07+nationProvCount(n)*0.04;
    if(n.gold<0){
      n.gold=0;
      n.stability=clamp(n.stability-2.5,0,100);
      if(n.armies.length&&Math.random()<0.3){
        const a=n.armies[Math.floor(Math.random()*n.armies.length)];
        a.units--;
        if(a.units<=0) removeArmy(n,a);
      }
    }else if(n.stability<72){
      n.stability=clamp(n.stability+0.45,0,100);
    }
    n.prestige=clamp(n.prestige*0.997,0,100);
  }
  for(const d of S.provs){
    if(!d.build) continue;
    d.build.left--;
    if(d.build.left<=0){
      const k=d.build.key;
      d.b[k]++; d.build=null;
      if(d.owner===S.playerId){ logMsg("Готово: "+BUILD[k].n+" в "+G.provs[d.id].name,"good"); if(S.stats) S.stats.buildings++; }
    }
  }
  for(const n of S.nations){
    for(const a of n.armies.slice()){
      if(a.units<=0) continue;
      const d=S.provs[a.loc];
      if(!d) continue;
      const own=d.owner===n.id;
      const occ=d.occupiedBy===n.id;
      const target=own?100:(occ?65:45);
      const cur=(a.supply===undefined?100:a.supply);
      a.supply=clamp(cur+(target>cur?18:-18),0,100);
      if(own) a.morale=clamp((a.morale===undefined?70:a.morale)+2.5,0,100);
      else a.morale=clamp((a.morale===undefined?70:a.morale)-1.5,0,100);
      if((a.supply||0)<30&&a.units>1){
        applyLosses(a,Math.max(1,Math.round(a.units*0.05)));
      }
      if(a.units<=0) removeArmy(n,a);
    }
  }
  const atWarSet=new Set();
  for(const k in S.wars){ const ab=k.split("-").map(Number); atWarSet.add(ab[0]); atWarSet.add(ab[1]); }
  const garrison=new Set();
  for(const n of S.nations) for(const a of n.armies) garrison.add(a.loc);
  for(const d of S.provs){
    let u=d.unrest||0;
    const owner=S.nations[d.owner];
    if(d.occupiedBy!=null) u+=1.2;
    else if(owner&&atWarSet.has(d.owner)) u+=0.4;
    if(owner&&owner.stability<45) u+=0.5;
    if(owner&&owner.stability>70) u-=0.6;
    if(garrison.has(d.id)) u-=1.0;
    d.unrest=clamp(u-0.2,0,100);
  }
  for(const d of S.provs){
    if(d.rebel||d.owner==null||d.occupiedBy!=null) continue;
    if((d.unrest||0)>=99&&Math.random()<0.35) startRebellion(d);
  }
  processSieges();
  for(const n of S.nations){
    n.armies=n.armies.filter(a=>a.units>0);
    for(const a of n.armies) a.moves=1;
  }
  for(const k in S.truces){ S.truces[k]--; if(S.truces[k]<=0) delete S.truces[k]; }
  for(const k in S.wars){ if(S.wars[k]) S.wars[k].len=(S.wars[k].len||0)+1; }
  navalTick();
  autoArmies();
  aiTurn();
  checkElimination();
  if(!S.ended&&Math.random()<0.12) fireEvent();
  if(!S.ended&&S.date.m===1) saveGame();
  checkAchievements();
  bakeDirty=true;
  updateTop();
  renderPanel();
  checkEnd();
}
function checkElimination(){
  for(const n of S.nations){
    if(n.dead||n.isRebel) continue;
    if(nationProvCount(n)===0){
      n.dead=true; n.armies=[];
      logMsg(n.name+" прекращает существование","war");
      const keys=Object.keys(S.wars);
      for(const k of keys){
        const ab=k.split("-").map(Number);
        if(ab[0]===n.id||ab[1]===n.id) delete S.wars[k];
      }
      if(n.id===S.playerId) endGame(false);
    }
  }
}
function checkEnd(){
  if(!S||S.ended) return;
  const P=S.nations[S.playerId];
  if(P.dead) return;
  const share=nationProvCount(P)/S.provs.length;
  if(share>=0.2){
    endGame(true, "Вы подчинили "+Math.round(share*100)+"% мира. "+P.name+" становится величайшей державой эпохи.");
  }else if(S.date.y>=2086){
    endGame(share>=0.12, "Летопись завершена в 2086 году. Под вашей рукой "+Math.round(share*100)+"% провинций.");
  }
}
function endGame(win, text){
  if(!S||S.ended) return;
  S.ended=win?"win":"lose";
  S.speed=0;
  updateTop();
  openModal(win?"Триумф":"Крах",
    text||(win?"Ваша держава достигла господства.":"Ваша держава пала."),
    [
      {label:"Новая партия", gold:true, fn:()=>{closeModal(); newGame();}},
      {label:"Рассмотреть карту", fn:()=>{}}
    ]);
}

