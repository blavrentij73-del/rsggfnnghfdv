    ctx.fillStyle=n.color; ctx.fillRect(0,0,W,H);
    ctx.fillStyle=shadeHex(n.color,n.id%2?-34:34); ctx.fillRect(0,H*0.55,W,H*0.45);
    return;
  }
  ctx.fillStyle=spec.bg||"#777777"; ctx.fillRect(0,0,W,H);
  for(const l of (spec.l||[])){
    if(l[0]==="r"){ ctx.fillStyle=l[5]; ctx.fillRect(X(l[1]),Y(l[2]),X(l[3]),Y(l[4])); }
    else if(l[0]==="c"){ ctx.fillStyle=l[4]; ctx.beginPath(); ctx.arc(X(l[1]),Y(l[2]),X(l[3]),0,Math.PI*2); ctx.fill(); }
    else if(l[0]==="cross"){
      ctx.fillStyle=l[4];
      const th=X(l[3]);
      ctx.fillRect(0,Y(l[2])-th/2,W,th);
      ctx.fillRect(X(l[1])-th/2,0,th,H);
