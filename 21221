    h+='</div>';
    h+='<div class="hint">Подарок: +12 к отношениям. Союз — при 40+. Война недоступна во время перемирия.</div>';
  }
  h+='</div>';
  return h;
}

function panelProv(){
  const id=S.sel.prov;
  if(id==null){
