функция makeGeneral(){
 const g={id:S.nextGen++, name:GEN_NAMES[Math.floor(Math.random()*GEN_NAMES.length)], bonus:Math.round((0.05+Math.random()*0.15)*100)/100};
 return g;
}
function buildCost(n,b){ return Math.max(20, Math.round(b.cost*(1-0.04*((n.tech&&n.tech.adm)||0)))); }
function assignGeneral(gid){
 const P=S.nations[S.playerId];
 const g=(P.generals||[]).find(x=>x.id===gid);
 if(!g) return;
 let army=null;
 if(S.sel.army!=null){
 const f=findArmy(S.sel.army);
 if(f&&f.nation.id===P.id) army=f.army;
 }
 if(!army) army=P.armies[0];
 if(!army) return toast("Сначала создайте армию");
 if(army.gen) P.generals.push(army.gen);
 P.generals=P.generals.filter(x=>x.id!==gid);
 army.gen=g;
 toast(g.name+" возглавил армию");
 renderPanel();
}
function recallGeneral(aid){
 const f=findArmy(aid);
 if(!f) return;
 const P=S.nations[S.playerId];
 if(f.nation.id!==P.id) return;
 if(f.army.gen){ P.generals.push(f.army.gen); f.army.gen=null; }
 renderPanel();
}

function buyTech(branch){
 const P=S.nations[S.playerId];
 const lvl=P.tech[branch]||0;
 if(lvl>=5) return toast("Ветка полностью изучена");
 const cost=TECH_COST[lvl];
  if((P.rp||0)<cost) return toast("Нужно "+cost+" очков развития");
  P.rp-=cost; P.tech[branch]=lvl+1;
  logMsg("Изучено: "+TECH[branch].n+" — уровень "+(lvl+1),"good");
  renderPanel(); updateTop();
}
