function ruName(s){
  if(/[А-Яа-яЁё]/.test(s)) return s;
  const low=s.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase();
  const dig=[["shch","щ"],["sch","щ"],["zh","ж"],["kh","х"],["ts","ц"],["ch","ч"],["sh","ш"],["yu","ю"],["ya","я"],["yo","ё"],["ye","е"],["ju","ю"],["ja","я"],["je","е"]];
  const one={a:"а",b:"б",v:"в",g:"г",d:"д",e:"е",z:"з",i:"и",y:"ы",k:"к",l:"л",m:"м",n:"н",o:"о",p:"п",r:"р",s:"с",t:"т",u:"у",f:"ф",h:"х",c:"к",w:"в",x:"кс",q:"к",j:"й"};
  let out="";
  let i=0;
  while(i<low.length){
    let hit=false;
    for(const d of dig){ if(low.startsWith(d[0],i)){ out+=d[1]; i+=d[0].length; hit=true; break; } }
    if(hit) continue;
    const c=low[i];
    out+= one[c]!==undefined? one[c] : c;
    i++;
  }
  out=out.replace(/(^|[\s\-])([а-яё])/g,(m,p,ch)=>p+ch.toUpperCase());
  return out;
}

