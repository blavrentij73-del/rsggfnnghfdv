        const b=cells[p+RW];
        if(b===65535) provs[a].coastal=true;
        else if(b!==a){ if(!adj[a].includes(b)) adj[a].push(b); if(!adj[b].includes(a)) adj[b].push(a); }
      } else provs[a].coastal=true;
      if(x===0||y===0) provs[a].coastal=true;
    }
  }

  const NN=provs.length;
  const isoMap={}, nations=[], natIndex=new Int32Array(NN);
  for(let i=0;i<NN;i++){
    const p=provs[i];
    let ni=isoMap[p.iso];
    if(ni===undefined){
      ni=nations.length; isoMap[p.iso]=ni;
      nations.push({id:ni, iso:p.iso, name:WORLD_RU[p.adm]||RU_NAMES[p.adm]||p.adm, color:null, capital:-1});
    }
    natIndex[i]=ni;
    if(nations[ni].capital<0||provs[i].area>provs[nations[ni].capital].area) nations[ni].capital=i;
  }
  for(const n of nations){
    const cap=CAPITALS[n.iso];
    if(!cap) continue;
    const cx0=(cap[0]-LON0)/(LON1-LON0)*RW;
    const cy0=(MY1-merc(cap[1]))/(MY1-MY0)*RH;
    if(cx0<0||cy0<0||cx0>=RW||cy0>=RH) continue;
    const bx=Math.round(cx0), by=Math.round(cy0);
    let found=-1;
    for(let r=0;r<20&&found<0;r++){
      for(let dy=-r;dy<=r&&found<0;dy++){
        for(let dx=-r;dx<=r&&found<0;dx++){
          if(Math.max(Math.abs(dx),Math.abs(dy))!==r) continue;
          const x=bx+dx, y=by+dy;
          if(x<0||y<0||x>=RW||y>=RH) continue;
          const pid=cells[y*RW+x];
          if(pid!==65535&&pid<NN&&natIndex[pid]===n.id) found=pid;
        }
      }
    }
    if(found>=0) n.capital=found;
  }
  {
    const pnat=Array.from({length:nations.length},()=>[]);
    for(let i=0;i<NN;i++) pnat[natIndex[i]].push(i);
    for(let k=0;k<nations.length;k++){
      const n=nations[k], list=pnat[k];
      let tot=0; for(const i of list) tot+=provs[i].area;
      let total=Math.max(0.3,tot/1400);
      if(POP[n.name]!==undefined) total=POP[n.name];
      else if(POP_ISO[n.iso]!==undefined) total=POP_ISO[n.iso];
      let wsum=0;
      const ws=list.map(i=>{ const w=Math.pow(provs[i].area,0.8); wsum+=w; return w; });
      list.forEach((i,j)=>{ provs[i].pop=Math.max(0.01, Math.round(total*ws[j]/wsum*100)/100); });
    }
  }
  const nSet=nations.map(()=>new Set());
  for(let i=0;i<NN;i++){
    for(const j of adj[i]){
      if(natIndex[i]!==natIndex[j]){ nSet[natIndex[i]].add(natIndex[j]); nSet[natIndex[j]].add(natIndex[i]); }
    }
  }
    const pal=[];
  const tones=[[24,58],[32,48],[20,66],[38,42],[28,62],[36,52]];
  for(let hk=0;hk<30;hk++) for(let t=0;t<tones.length;t++) pal.push(hslToHex(hk*12,tones[t][0],tones[t][1]));
  const palRGB=pal.map(c=>[parseInt(c.slice(1,3),16),parseInt(c.slice(3,5),16),parseInt(c.slice(5,7),16)]);
  const palIdx=new Map(); for(let i=0;i<pal.length;i++) palIdx.set(pal[i],i);
  const cdist=(a,b)=>{const dr=a[0]-b[0],dg=a[1]-b[1],db=a[2]-b[2];return dr*dr*0.3+dg*dg*0.59+db*db*0.11;};
  const colors=new Array(nations.length).fill(null);
  const order=nations.map(n=>n.id).sort((a,b)=>nSet[b].size-nSet[a].size);
  for(const id of order){
    const near=[];
    for(const nb of nSet[id]){
      if(colors[nb]) near.push(palRGB[palIdx.get(colors[nb])]);
      for(const nn of nSet[nb]) if(nn!==id&&colors[nn]) near.push(palRGB[palIdx.get(colors[nn])]);
    }
    if(!near.length){ colors[id]=pal[(id*17)%pal.length]; continue; }
    let best=0,bd=-1;
    for(let k=0;k<pal.length;k++){
      let md=1e12;
      for(const u of near){ const d=cdist(palRGB[k],u); if(d<md) md=d; }
      if(md>bd){ bd=md; best=k; }
    }
    colors[id]=pal[best];
  }
  for(const n of nations) n.color=colors[n.id];
  const siteMap=new Int32Array(65536).fill(-1);
  for(let i=0;i<NN;i++) siteMap[i]=i;
  LAKES=(MAPDATA.lakes||[]).filter(poly=>poly.length&&poly[0].length>=8);
  const SZW2=200, seaCols=Math.ceil(RW/SZW2), seaRows=Math.ceil(RH/SZW2);
  const seaWater=new Uint8Array(seaCols*seaRows);
  for(let y2=0;y2<RH;y2++){
    for(let x2=0;x2<RW;x2++){
      if(cells[y2*RW+x2]===65535) seaWater[((y2/SZW2)|0)*seaCols+((x2/SZW2)|0)]=1;
    }
  }
  const seaZones={cols:seaCols, rows:seaRows, water:seaWater};

  return {seed, cells, siteMap, provs, adj, nations, owners:Array.from(natIndex), seaZones};
}

function warKey(a,b){return a<b? a+"-"+b : b+"-"+a;}
function isWar(a,b){return !!S.wars[warKey(a,b)];}
function hasTruce(a,b){return (S.truces[warKey(a,b)]||0)>0;}
function relKey(a,b){return a<b? a+"-"+b : b+"-"+a;}
function getRel(a,b){return S.rel[relKey(a,b)]||0;}
function setRel(a,b,v){S.rel[relKey(a,b)]=clamp(v,-100,100);}
function addRel(a,b,v){setRel(a,b,getRel(a,b)+v);}

function provIncome(id){
  const p=G.provs[id], d=S.provs[id];
  if(d.rebel) return 0;
  const t=TERRAIN[p.terrain];
  let v=((d.pop||0)*0.1+d.dev*0.12+d.b.farm*3+d.b.mine*4+d.b.workshop*6)*t.inc;
  if(p.coastal) v*=1.12;
  v*=(1-Math.min(0.5,(d.unrest||0)/200));
  return v;
}
function nationPop(n){
  let v=0;
  for(const d of S.provs) if(d.owner===n.id) v+=d.pop||0;
