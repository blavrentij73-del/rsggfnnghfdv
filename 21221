function startRebellion(d){
  const rebel=S.nations.find(n=>n.isRebel);
  if(!rebel) return;
  d.rebel=true; d.unrest=100; d.siege=0; d.occupiedBy=null;
  const units=clamp(2+Math.round(d.dev/2),2,10);
  rebel.armies.push({id:S.nextArmy++, units, cav:0, art:0, loc:d.id, moves:0, gen:null});
  S.wars[warKey(d.owner,rebel.id)]={len:0};
  logMsg("Восстание в "+G.provs[d.id].name+"!","war");
  toast("Восстание: "+G.provs[d.id].name);
