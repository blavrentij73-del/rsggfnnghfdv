}

function computeTrade(){
  const t={};
  for(let i=0;i<G.provs.length;i++){
    const a=S.provs[i];
    for(const j of G.adj[i]){
      if(j<=i) continue;
      const b=S.provs[j];
      if(a.owner===b.owner) continue;
      if(isWar(a.owner,b.owner)) continue;
      if(a.occupiedBy!=null||b.occupiedBy!=null) continue;
      const v=((a.pop||0)+(b.pop||0))*0.02;
      t[a.owner]=(t[a.owner]||0)+v;
      t[b.owner]=(t[b.owner]||0)+v;
    }
  }
  S.trade=t;
}
function nationIncome(n){
  let v=0;
  for(let i=0;i<S.provs.length;i++){
    const d=S.provs[i];
    if(d.owner===n.id && d.occupiedBy==null) v+=provIncome(i);
    else if(d.occupiedBy===n.id) v+=provIncome(i)*0.6;
  }
  return v*(0.55+n.stability/140)*(1+0.06*((n.tech&&n.tech.eco)||0))+((S.trade&&S.trade[n.id])||0);
}
function nationUnits(n){let u=0; for(const a of n.armies) u+=a.units; return u;}
function armyPower(a){
  const art=Math.min(a.art||0,a.units);
  const cav=Math.min(a.cav||0,a.units-art);
  const inf=Math.max(0,a.units-art-cav);
  const m=0.6+((a.morale===undefined?70:a.morale)/250);
  const e=1+0.06*(a.exp||0);
  const s=0.8+0.2*((a.supply===undefined?100:a.supply)/100);
  return (inf*1+cav*1.4+art*0.8)*m*e*s;
}
function siegePower(a){
  const art=Math.min(a.art||0,a.units);
  return ((a.units-art)*25+art*60)*(0.7+0.3*((a.supply===undefined?100:a.supply)/100));
}
function applyLosses(a,k){
  k=Math.min(k,a.units);
  if(k<=0) return;
  const ratio=k/(a.units||1);
  const art=Math.min(a.art||0,Math.round(k*((a.art||0)/(a.units||1))));
  const cav=Math.min(a.cav||0,Math.round(k*((a.cav||0)/(a.units||1))));
  a.art=Math.max(0,(a.art||0)-art);
  a.cav=Math.max(0,(a.cav||0)-cav);
  a.units-=k;
  if((a.cav||0)>a.units) a.cav=a.units;
  if((a.art||0)>a.units-(a.cav||0)) a.art=Math.max(0,a.units-(a.cav||0));
  a.morale=clamp((a.morale===undefined?70:a.morale)-ratio*55,0,100);
}
