function splitArmy(id){
  const f=findArmy(id);
  if(!f) return;
  const n=f.nation, a=f.army;
  if(a.units<2) return toast("Слишком мало полков");
  const half=Math.floor(a.units/2);
  const b={id:S.nextArmy++, units:a.units-half, cav:Math.ceil((a.cav||0)/2), art:Math.ceil((a.art||0)/2), loc:a.loc, moves:0, gen:null, morale:(a.morale===undefined?70:a.morale), supply:(a.supply===undefined?100:a.supply), exp:(a.exp||0)};
  a.units=half;
  a.cav=Math.floor((a.cav||0)/2);
  a.art=Math.floor((a.art||0)/2);
  n.armies.push(b);
  logMsg("Армия разделена в "+G.provs[a.loc].name,"war");
  renderPanel(); updateTop();
}
function mergeArmies(id){
  const f=findArmy(id);
  if(!f) return;
  const n=f.nation, a=f.army;
  const other=n.armies.find(x=>x.id!==a.id&&x.loc===a.loc);
  if(!other) return toast("В этой провинции нет другой вашей армии");
  const total=other.units+a.units;
  const mo=(other.morale===undefined?70:other.morale), ma=(a.morale===undefined?70:a.morale);
  const so=(other.supply===undefined?100:other.supply), sa=(a.supply===undefined?100:a.supply);
  other.morale=Math.round((mo*other.units+ma*a.units)/Math.max(1,total));
  other.supply=Math.round((so*other.units+sa*a.units)/Math.max(1,total));
  other.units=total;
  other.cav=(other.cav||0)+(a.cav||0);
  other.art=(other.art||0)+(a.art||0);
  other.exp=Math.max(other.exp||0,a.exp||0);
  removeArmy(n,a);
  S.sel.army=other.id;
  logMsg("Армии объединены в "+G.provs[other.loc].name,"war");
  renderPanel(); updateTop();
}
function recruitType(type){
  const P=S.nations[S.playerId];
  const cfg={inf:{g:30,m:2,n:"пехота"},cav:{g:45,m:2,n:"кавалерия"},art:{g:60,m:3,n:"артиллерия"}}[type||"inf"];
  if(!cfg) return;
  if(P.gold<cfg.g) return toast("Нужно "+cfg.g+" золота");
  if(P.manpower<cfg.m) return toast("Не хватает людских ресурсов");
  P.gold-=cfg.g; P.manpower-=cfg.m;
  let a=P.armies.find(x=>x.loc===P.capital);
  if(!a){ addArmy(P,P.capital,0); a=P.armies[P.armies.length-1]; }
  a.units++;
  if(type==="cav") a.cav=(a.cav||0)+1;
  if(type==="art") a.art=(a.art||0)+1;
  logMsg("Навербован полк: "+cfg.n+" в "+G.provs[P.capital].name,"gold");
  renderPanel(); updateTop();
}
