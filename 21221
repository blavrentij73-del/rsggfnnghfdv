function bake(){
  if(!bakeCv){
    bakeCv=document.createElement("canvas");
    bakeCv.width=RW; bakeCv.height=RH;
    bakeCtx=bakeCv.getContext("2d");
  }
  const img=bakeCtx.createImageData(RW,RH);
  const data=img.data;
  const colCache={};
  const ownerCache={};
  const ownerOf=pid=>{
    if(pid<0) return -1;
    if(ownerCache[pid]===undefined) ownerCache[pid]=S.provs[pid]?S.provs[pid].owner:-1;
    return ownerCache[pid];
  };
  for(let y=0;y<RH;y++){
    for(let x=0;x<RW;x++){
      const p=y*RW+x;
      const pid=siteProv[cell[p]];
      let r,g,b;
      if(pid<0){
        const n=((x*7+y*11)%5)-2;
        r=14+n; g=28+n; b=42+n;
      }else{
        if(!colCache[pid]) colCache[pid]=provFill(pid);
        const c=colCache[pid];
        const pr=G.provs[pid];
        const k=(pr.terrain==="mountains"?0.70:pr.terrain==="forest"?0.84:pr.terrain==="hills"?0.92:1.0)+pr.jitter/100;
        r=c[0]*k; g=c[1]*k; b=c[2]*k;
        const right=(x+1<RW)?siteProv[cell[p+1]]:-2;
        const down=(y+1<RH)?siteProv[cell[p+RW]]:-2;
        let bord=false, coast=false, natBord=false;
        if(right!==pid){
          if(right<0) coast=true;
          else { bord=true; if(ownerOf(right)!==ownerOf(pid)) natBord=true; }
        }
        if(down!==pid){
          if(down<0) coast=true;
          else { bord=true; if(ownerOf(down)!==ownerOf(pid)) natBord=true; }
        }
        if(coast){ r=r*0.55+70; g=g*0.55+105; b=b*0.55+130; }
        else if(natBord){ r*=0.36; g*=0.36; b*=0.36; }
        else if(bord){ r*=0.74; g*=0.74; b*=0.74; }
      }
      const o=p*4;
      data[o]=clamp(r,0,255); data[o+1]=clamp(g,0,255); data[o+2]=clamp(b,0,255); data[o+3]=255;
    }
  }
  bakeCtx.putImageData(img,0,0);
  if(LAKES.length){
    bakeCtx.fillStyle="rgba(58,104,142,0.96)";
    for(const poly of LAKES){
      bakeCtx.beginPath();
      for(const ring of poly){
        bakeCtx.moveTo(ring[0],ring[1]);
        for(let i=2;i<ring.length;i+=2) bakeCtx.lineTo(ring[i],ring[i+1]);
        bakeCtx.closePath();
      }
      bakeCtx.fill("evenodd");
    }
  }
  if(MAPDATA.rivers){
    bakeCtx.strokeStyle="rgba(104,170,215,0.7)";
    bakeCtx.lineWidth=1;
    for(const r of MAPDATA.rivers){
      bakeCtx.beginPath();
      bakeCtx.moveTo(r[0],r[1]);
      for(let i=2;i<r.length;i+=2) bakeCtx.lineTo(r[i],r[i+1]);
      bakeCtx.stroke();
    }
  }
}

function rebuildOverlay(){
  if(!ovCv){
    ovCv=document.createElement("canvas");
    ovCv.width=RW; ovCv.height=RH;
    ovCtx=ovCv.getContext("2d");
    ovCtx.clearRect(0,0,RW,RH);
  }
  ovCtx.clearRect(0,0,RW,RH);
  const img=ovCtx.createImageData(RW,RH);
  const data=img.data;
  const sel=S.sel.prov;
  const targets=new Set();
  if(S.sel.army!=null){
    const f=findArmy(S.sel.army);
    if(f) for(const nb of G.adj[f.army.loc]) targets.add(nb);
  }
  const markSel=sel!=null, markTgt=targets.size>0;
  if(!markSel && !markTgt){ ovDirty=false; return; }
  for(let p=0;p<RW*RH;p++){
    const pid=siteProv[cell[p]];
    if(pid<0) continue;
    let a=0, r=255, g=255, b=255;
    if(markTgt && targets.has(pid)){ a=0.20; r=217; g=181; b=102; }
    if(markSel && pid===sel){ a=0.26; r=255; g=250; b=235; }
    if(!a) continue;
    const o=p*4;
    data[o]=r; data[o+1]=g; data[o+2]=b; data[o+3]=Math.round(a*255);
  }
  ovCtx.putImageData(img,0,0);
  ovDirty=false;
}
