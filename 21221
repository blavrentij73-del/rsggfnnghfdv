function moveArmy(n, arm, dest, silent){
  const maybeToast=m=>{if(!silent) toast(m);};
  if(arm.moves<=0){maybeToast("Армия уже шла в этом месяце");return false;}
  const adjacent=G.adj[arm.loc].includes(dest);
  if(!adjacent){
    const fromP=G.provs[arm.loc], toP=G.provs[dest];
    if(fromP.coastal&&toP.coastal&&canEnter(n.id,dest)){
      if((n.ships||0)<=0){maybeToast("Нужен флот для морской переброски");return false;}
      if(arm.units>(n.ships||0)*4){maybeToast("Флот мал: нужно "+Math.ceil(arm.units/4)+" кораблей");return false;}
      const cost=Math.round(arm.units*4);
      if(n.gold<cost){maybeToast("Морская переброска стоит "+cost+" золота");return false;}
const zO=zoneOfProv(arm.loc), zD=zoneOfProv(dest);
      if(!n.fleet||zoneDist(n.fleet.z,zO)>1){maybeToast("Флот не в этом порту");return false;}
      if(S.provs[arm.loc].block||S.provs[dest].block){maybeToast("Порт блокирован");return false;}
      const seaFoes=S.nations.filter(x=>x.id!==n.id&&!x.dead&&!x.isRebel&&isWar(n.id,x.id)&&(x.ships||0)>0&&x.fleet&&(x.fleet.z===zO||x.fleet.z===zD));
      if(seaFoes.length){
        const es=seaFoes.reduce((s,x)=>s+(x.ships||0),0);
        const pr=es/(es+(n.ships||0)+2);
        if(Math.random()<pr){
          const lost=Math.max(1,Math.round(arm.units*(0.3+Math.random()*0.3)));
          applyLosses(arm,lost);
          if(Math.random()<0.25) n.ships=Math.max(0,(n.ships||0)-1);
          if(!silent) logMsg("Флот перехвачен у "+n.short+": потеряно "+lost+" полков","war");
          if(arm.units<=0) removeArmy(n,arm);
          bakeDirty=true;
          return false;
        }
      }
      n.gold-=cost; arm.loc=dest; arm.moves=0;
      if(!silent) logMsg(n.short+": армия переброшена морем в "+G.provs[dest].name,"war");
      bakeDirty=true;
      return true;
    }
    maybeToast("Только в соседнюю провинцию или морем между портами");
    return false;
  }
  if(!canEnter(n.id,dest)){maybeToast("Нет военного доступа: сначала война с "+S.nations[S.provs[dest].owner].short);return false;}
  const d=S.provs[dest];
  const atWar=isWar(n.id,d.owner);
  const foes=armiesAt(dest).filter(h=>h.nation.id!==n.id && isWar(n.id,h.nation.id) && !h.nation.dead);
  arm.moves=0;
  if(foes.length){
    doBattle(n,arm,foes[0],dest,silent);
    return true;
  }
  arm.loc=dest;
  if(d.owner!==n.id && atWar){
    const def=1+d.b.fort*0.7;
    d.siege=clamp(d.siege+ (siegePower(arm)*0.4)/def, 0, 100);
    if(!silent) logMsg(n.short+": армия вошла в "+G.provs[dest].name+". Началась осада.","war");
    if(d.siege>=100) occupy(dest, n.id, silent);
  } else if(d.owner===n.id && d.siege>0){
    d.siege=0;
  }
  bakeDirty=true;
  return true;
}
function occupy(provId, nid, silent){
  const d=S.provs[provId];
  d.occupiedBy=nid; d.siege=0;
  const n=S.nations[nid];
  n.prestige=clamp(n.prestige+1.5,0,100);
  S.nations[d.owner].stability=clamp(S.nations[d.owner].stability-2,0,100);
  logMsg(G.provs[provId].name+" оккупирована: "+n.name,"war");
  bakeDirty=true;
}
function doBattle(n, arm, foe, destId, silent){
  const d=S.provs[destId], tp=G.provs[destId];
  const gm=(n.tech&&n.tech.mil)||0, gd=(foe.nation.tech&&foe.nation.tech.mil)||0;
  const garrison=(d.owner===foe.nation.id)?(d.dev*0.5+d.b.fort*1.4):0;
  const attPow=armyPower(arm)*(1+n.prestige/500+0.04*gm+(arm.gen?arm.gen.bonus:0));
  const defPow=(armyPower(foe.army)+garrison)*(1+foe.nation.prestige/500+0.04*gd+(foe.army.gen?foe.army.gen.bonus:0)+TERRAIN[tp.terrain].def+d.b.fort*0.15);
  const rA=attPow*(0.72+Math.random()*0.56);
  const rD=defPow*(0.72+Math.random()*0.56);
  const win=rA>rD;
  let al=Math.round(arm.units*((win?0.12:0.38)+Math.random()*0.12));
  let dl=Math.round(foe.army.units*((win?0.42:0.12)+Math.random()*0.14));
  if(win&&dl===0&&foe.army.units>0) dl=1;
  if(!win&&al===0&&arm.units>0) al=1;
  al=clamp(al,0,arm.units);
  dl=clamp(dl,0,foe.army.units);
  applyLosses(arm,al);
  applyLosses(foe.army,dl);
  arm.exp=Math.min(5,(arm.exp||0)+(win?0.35:0.15));
  foe.army.exp=Math.min(5,(foe.army.exp||0)+(win?0.15:0.35));
  const involved=n.id===S.playerId||foe.nation.id===S.playerId;
  const line="Битва при "+G.provs[destId].name+": "+n.short+" vs "+foe.nation.short+". Потери "+al+" и "+dl+". Победа: "+n.short;
  if(win){
    n.prestige=clamp(n.prestige+2.5,0,100);
    foe.nation.prestige=clamp(foe.nation.prestige-1,0,100);
    foe.nation.stability=clamp(foe.nation.stability-3,0,100);
    logMsg(line,"war");
    if(involved) toast("Победа при "+G.provs[destId].name+"! Потери: "+al);
    if(n.id===S.playerId&&S.stats) S.stats.battles++;
  }else{
    n.prestige=clamp(n.prestige-1,0,100);
    foe.nation.prestige=clamp(foe.nation.prestige+2.5,0,100);
    logMsg("Битва при "+G.provs[destId].name+": "+n.short+" отброшен, потери "+al+" и "+dl,"war");
    if(involved) toast("Поражение при "+G.provs[destId].name+". Потери: "+al);
  }
  if(arm.units>0&&!win){
    const rb=retreatProv(n,arm.loc);
    if(rb!=null){ arm.loc=rb; arm.moves=0; arm.supply=Math.max(0,(arm.supply===undefined?100:arm.supply)-15); }
  }
  if(foe.army.units>0&&win){
    const rb2=retreatProv(foe.nation,destId);
    if(rb2!=null){ foe.army.loc=rb2; foe.army.moves=0; foe.army.supply=Math.max(0,(foe.army.supply===undefined?100:foe.army.supply)-15); }
  }
  if(arm.units<=0) removeArmy(n,arm);
  if(foe.army.units<=0) removeArmy(foe.nation,foe.army);
  if(foe.nation.isRebel&&foe.army.units<=0){
    const rp=S.provs[destId];
    rp.rebel=false; rp.unrest=25;
    logMsg("Восстание в "+G.provs[destId].name+" подавлено","good");
    toast("Мятеж подавлен: "+G.provs[destId].name);
  }
  if(win && arm.units>0){
    arm.loc=destId;
    const dd=S.provs[destId];
    if(dd.owner!==n.id){
      dd.siege=clamp(dd.siege+35,0,100);
      if(dd.siege>=100) occupy(destId,n.id,silent);
    }
  }
  bakeDirty=true;
}
function canEnter(nid, pid){
  const o=S.provs[pid].owner;
  if(o===nid) return true;
  if(isWar(nid,o)) return true;
  const n=S.nations[nid];
  return n.allies.includes(o);
}
function findStep(start, pred, allowed){
  const seen=new Set([start]);
  const q=[];
  for(const nb of G.adj[start]){
    if(allowed && !allowed(nb)) continue;
    seen.add(nb); q.push([nb,nb]);
  }
  let guard=0;
  while(q.length && guard++<4000){
    const [cur,first]=q.shift();
    if(pred(cur)) return first;
    for(const nb of G.adj[cur]){
      if(seen.has(nb)) continue;
      if(allowed && !allowed(nb)) continue;
      seen.add(nb); q.push([nb,first]);
    }
  }
  return null;
}

function startWar(aId,bId){
  if(isWar(aId,bId)) return;
  S.wars[warKey(aId,bId)]={len:0};
  setRel(aId,bId,getRel(aId,bId)-55);
  const A=S.nations[aId], B=S.nations[bId];
  B.stability=clamp(B.stability-6,0,100);
  const join=(allyId,sideId,foeId)=>{
    if(allyId===sideId||allyId===foeId) return;
    const al=S.nations[allyId];
    if(!al||al.dead) return;
    if(isWar(allyId,foeId)) return;
    S.wars[warKey(allyId,foeId)]={len:0};
    addRel(allyId,foeId,getRel(allyId,foeId)-40);
    logMsg(al.name+" вступает в войну на стороне "+S.nations[sideId].name,"war");
  };
  for(const allyId of (B.allies||[])) join(allyId,bId,aId);
  for(const allyId of (A.allies||[])) join(allyId,aId,bId);
}
function declareWar(id){
  const P=S.nations[S.playerId], n=S.nations[id];
  if(n.dead) return;
  if(P.allies.includes(n.id)) return toast("Это ваш союзник");
  if(hasTruce(P.id,n.id)) return toast("Действует перемирие ещё "+S.truces[warKey(P.id,n.id)]+" мес.");
  if(isWar(P.id,id)) return;
  startWar(P.id,id);
  P.prestige=clamp(P.prestige+2,0,100);
  logMsg("Война объявлена: "+P.name+" против "+n.name,"war");
  toast("Война с "+n.short);
  if(S.speed===0) S.speed=1;
  renderPanel(); updateTop();
}
function doPeace(aId,bId){
  const A=S.nations[aId], B=S.nations[bId];
  if(!isWar(aId,bId)) return;
  let gainedA=0;
  for(const d of S.provs){
    if(d.occupiedBy===aId && d.owner===bId){ d.owner=aId; d.occupiedBy=null; d.siege=0; gainedA++; }
    else if(d.occupiedBy===bId && d.owner===aId){ d.owner=bId; d.occupiedBy=null; d.siege=0; gainedA--; }
    else if(d.occupiedBy!=null && (d.owner===aId||d.owner===bId)){ d.occupiedBy=null; d.siege=0; }
  }
  delete S.wars[warKey(aId,bId)];
  S.truces[warKey(aId,bId)]=36;
  if((aId===S.playerId||bId===S.playerId)&&S.stats) S.stats.peaces++;
  A.prestige=clamp(A.prestige+2,0,100);
  B.prestige=clamp(B.prestige+2,0,100);
  if(aId===S.playerId||bId===S.playerId){
    const mine=aId===S.playerId?gainedA:-gainedA;
    setRel(S.playerId, aId===S.playerId?bId:aId, -8);
    logMsg("Мир: "+A.name+" и "+B.name+". Вы получили провинций: "+Math.max(0,mine)+", потеряли: "+Math.max(0,-mine),"good");
    toast("Заключён мир");
  }else{
    logMsg("Мир между "+A.name+" и "+B.name,"");
  }
  COUNTS=null;
  bakeDirty=true;
  checkElimination();
  checkEnd();
  renderPanel(); updateTop();
}
