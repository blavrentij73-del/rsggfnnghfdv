function achDone(a,P){
  if(a.id==="first") return ((S.stats&&S.stats.battles)||0)>=1;
  if(a.id==="builder") return ((S.stats&&S.stats.buildings)||0)>=10;
  if(a.id==="rich") return P.gold>=1000;
  if(a.id==="conq10") return nationProvCount(P)>=10;
  if(a.id==="conq30") return nationProvCount(P)>=30;
  if(a.id==="sci") return Math.max(P.tech.eco||0,P.tech.mil||0,P.tech.adm||0)>=3;
  if(a.id==="ally") return (P.allies||[]).length>0;
  if(a.id==="peace") return ((S.stats&&S.stats.peaces)||0)>=1;
  if(a.id==="army50") return nationUnits(P)>=50;
  if(a.id==="survive") return S.date.y>=2036;
  return false;
}
function checkAchievements(){
  if(!S||!S.stats) return;
  const P=S.nations[S.playerId];
  if(!P||P.dead) return;
  for(const a of ACH){
    if(S.stats.unlocked[a.id]) continue;
    let ok=false;
    try{ ok=achDone(a,P); }catch(e){ ok=false; }
    if(ok){
      S.stats.unlocked[a.id]=true;
      logMsg("Достижение: "+a.n,"good");
      toast("Достижение: "+a.n);
    }
  }
}
