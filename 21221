  let h='<div class="sec"><h3>Держава</h3>';
  h+='<div class="row"><span>Название</span><b style="color:'+own.color+'">'+flagHTML(own)+own.name+'</b></div>';
  h+='<div class="row"><span>Столица</span><b>'+G.provs[own.capital].name+'</b></div>';
  h+='<div class="row"><span>Провинций</span><b>'+nationProvCount(own)+'</b></div>';
  h+='<div class="row"><span>Население</span><b>'+fmt1(nationPop(own))+' млн</b></div>';
  h+='<div class="row"><span>Полков</span><b>'+nationUnits(own)+'</b></div>';
  if(isMine){
    h+='<div class="btnrow"><button class="btn small gold" data-act="tab:nation">Открыть мою державу</button>'+
       '<button class="btn small" data-act="focus:'+own.capital+'">К столице</button></div>';
