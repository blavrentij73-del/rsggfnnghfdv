<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Державы — карта мира</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0d1216;--panel:#141b21;--panel2:#1a242c;--line:#28343d;--gold:#d9b566;--text:#d5dde4;--dim:#8797a4;--good:#7fc187;--bad:#de7a6c}
html,body{height:100%;overflow:hidden}
body{background:var(--bg);color:var(--text);font:13.5px/1.45 "Segoe UI",system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}
#app{display:flex;flex-direction:column;height:100vh}
#topbar{display:flex;align-items:center;gap:16px;padding:7px 14px;background:linear-gradient(#18222a,#10171c);border-bottom:1px solid var(--line);flex:0 0 auto}
.brand{display:flex;flex-direction:column;line-height:1.05;padding-right:14px;border-right:1px solid var(--line)}
.brand b{font-family:Georgia,"Times New Roman",serif;letter-spacing:.16em;font-size:16px;color:var(--gold);font-weight:600}
.brand span{font-size:9px;letter-spacing:.22em;color:var(--dim);text-transform:uppercase}
.stats{display:flex;gap:15px;flex:1;overflow:hidden}
.stat{display:flex;flex-direction:column;min-width:0}
.stat label{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);white-space:nowrap}
.stat b{font-size:13.5px;font-weight:600;white-space:nowrap}
.stat i{font-style:normal;font-size:10.5px;color:var(--dim);white-space:nowrap}
.ctrl{display:flex;gap:8px;align-items:center}
.speed{display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.speed button{background:#131c22;color:var(--dim);border:0;padding:6px 8px;font-size:10px;cursor:pointer}
.speed button+button{border-left:1px solid var(--line)}
.speed button.on{background:var(--gold);color:#12181d;font-weight:700}
main{flex:1;display:flex;min-height:0}
#mapwrap{flex:1;position:relative;background:#0a1014;min-width:0;overflow:hidden}
#map{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:crosshair}
#tip{position:absolute;pointer-events:none;background:rgba(9,14,18,.94);border:1px solid var(--line);border-radius:5px;padding:4px 8px;font-size:11.5px;white-space:nowrap;z-index:5;transform:translate(12px,-50%)}
#zoomctl{position:absolute;right:12px;top:12px;display:flex;flex-direction:column;gap:5px;z-index:6}
#zoomctl button{width:30px;height:30px;background:rgba(16,23,28,.9);color:#d5dde4;border:1px solid #34434f;border-radius:6px;font-size:15px;cursor:pointer;line-height:1;font-family:inherit}
#zoomctl button:hover{background:#22303a;border-color:#4a5d6c}#legend{position:absolute;left:12px;bottom:10px;font-size:11px;color:#6d7c89;pointer-events:none;line-height:1.5}
#toast{position:absolute;left:50%;top:14px;transform:translateX(-50%);background:rgba(12,18,23,.95);border:1px solid #3d4d5b;border-radius:6px;padding:7px 14px;font-size:12.5px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:20}
#toast.on{opacity:1}
#side{width:346px;flex:0 0 346px;background:var(--panel);border-left:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
#tabs{display:flex;border-bottom:1px solid var(--line);flex:0 0 auto}
#tabs button{flex:1;background:transparent;border:0;color:var(--dim);padding:9px 2px;font-size:11px;cursor:pointer;border-bottom:2px solid transparent;font-family:inherit}
#tabs button.on{color:var(--gold);border-bottom-color:var(--gold);background:#18222a}
#panel{flex:1;overflow-y:auto;padding:12px 13px 26px}
#panel::-webkit-scrollbar{width:8px}
#panel::-webkit-scrollbar-thumb{background:#2a3742;border-radius:4px}
.sec{margin-bottom:13px;padding-bottom:11px;border-bottom:1px solid #1f2a32}
.sec:last-child{border:0;margin-bottom:0}
h3{font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:7px}
h2.prov{font-family:Georgia,serif;font-size:19px;color:#eadfc4;margin-bottom:1px;line-height:1.2}
.muted{color:var(--dim);font-size:12px}
.row{display:flex;justify-content:space-between;gap:10px;padding:2px 0;font-size:12.5px}
.row span{color:var(--dim)}
.row b{font-weight:600}
.btn{background:#22303a;color:#dfe7ee;border:1px solid #31424f;border-radius:5px;padding:6px 9px;font-size:12px;cursor:pointer;font-family:inherit;transition:background .12s}
.btn: наведение курсора {фон: #2b3c48; цвет границы: #3d5364} 
.btn: отключено {непрозрачность: .38; курсор: запрещен} 
.btn.gold{фон: #3d3320; цвет рамки: #5e4d2a; цвет: #e8c987} 
.btn.gold:наведите курсор {фон: #4a3e26} 
.btn.small{отступ: 3x7 пикселей; размер шрифта: 11 пикселей} 
.btn.wide{ширина: 100%; выравнивание текста: по левому краю} 
.btn.danger{фон: #3a2224; цвет границы: #5b3033; цвет: #e8a49a} 
.btn.опасность: наведение курсора{фон:#472a2d}
.btnrow{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}
.bar{height:5px;background:#1c262e;border-radius:3px;overflow:hidden;margin:5px 0 3px}
.bar i{display:block;height:100%;background:var(--gold);transition:width .2s}
.bar.red i{background:var(--bad)}
.bar.green i{background:var(--good)}
.tag{display:inline-block;font-size:10px;padding:1px 6px;border-radius:3px;background:#22303a;color:#9fb1bf;margin-left:4px;vertical-align:1px}
.flag{отображать: встроенный блок; ширина: 18 пикселей; высота: 12 пикселей; граница-радиус: 2 пикселя; граница: 1 пиксель сплошной rgba (0,0,0, .45); выравнивание по вертикали:-1 пиксель; правое поле: 6 пикселей; вставка-тень: 0 0 0 1 пиксель rgba (255,255,255,.06)} 
.tag.war{фон: #43262a; цвет: #e2a49b} 
.tag.ally{фон: #1f3a2c; цвет: #9ed3ab} 
.tag.occ{фон: #3d3320; цвет: #e8c987} 
.army{отображение:flex; выравнивание-элементы:по центру; зазор: 7 пикселей; отступ: 5x6 пикселей; граница-радиус: 5 пикселей; фон: #18222a; поле-низ: 4 пикселя; курсор: указатель; граница: сплошная прозрачная 1 пиксель} 
.армия:наведение курсора{фон: #1e2a33}
.army.on{border-color:var(--gold);background:#222d36}
.army .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
.army .nm{flex:1;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.army .un{font-size:11.5px;color:var(--gold)}
.natrow{display:flex;align-items:center;gap:7px;padding:5px 0;border-bottom:1px solid #1c262e;font-size:12.5px}
.natrow .dot{ширина: 9 пикселей; высота: 9 пикселей; радиус границы: 2 пикселя; изгиб: 0 0 авто} 
.natrow .nm{flex:1;overflow: скрытый;text-overflow: многоточие;пробел: nowrap} 
.natrow .v{цвет: var(--dim); размер шрифта: 11.5пикселей; минимальная ширина: 34 пикселя; выравнивание текста: по правому краю} 
.logline{размер шрифта: 12px; отступ: 3px 0; нижняя граница: 1px сплошная #1a232a; цвет: #b9c6d1}
.logline.war{color:#e2a49b}
.logline.good{color:#9ed3ab}
.logline.gold{color:#e8c987}
.logline .d{color:#6d7c89;font-size:10.5px;margin-right:6px}
#modal{position:fixed;inset:0;background:rgba(6,10,13,.72);display:flex;align-items:center;justify-content:center;z-index:50;backdrop-filter:blur(3px)}
#modal.hidden{display:none}
#modal .box{width:min(460px,92vw);background:linear-gradient(#1a242c,#131b21);border:1px solid #3a4b58;border-radius:10px;padding:20px 22px;box-shadow:0 20px 60px rgba(0,0,0,.6)}
#modal h2{font-family:Georgia,serif;font-size:19px;color:#eadfc4;margin-bottom:9px;font-weight:500}
#modal p{font-size:13px;color:#b9c6d1;margin-bottom:14px;line-height:1.55}
#m-opts{display:flex;flex-direction:column;gap:7px}
#m-opts .btn{text-align:left;width:100%}
.hint{font-size:11.5px;color:#75848f;margin-top:2px}
</style>
</head>
<body>
