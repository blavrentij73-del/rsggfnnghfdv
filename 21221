  let slots=0;
  for(const k in BUILD){
    if(d.b[k]>0){ slots+=d.b[k]; h+='<div class="row"><span>'+BUILD[k].n+'</span><b>'+d.b[k]+'</b></div>'; }
  }
  slots=Object.values(d.b).reduce((a,b)=>a+b,0);
  if(slots===0) h+='<div class="muted">Пока ничего не построено</div>';
  if(d.build){
