function retreatProv(n, from){
  const opts=G.adj[from].filter(p=>S.provs[p].owner===n.id&&S.provs[p].occupiedBy==null);
  if(!opts.length) return null;
  opts.sort((a,b)=>(S.provs[b].dev||0)-(S.provs[a].dev||0));
  return opts[0];
