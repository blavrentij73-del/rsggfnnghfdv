let VIEW={zoom:1, cx:500, cy:400};
let LAKES=[];
function mapView(cw,ch){
  const base=Math.min(cw/RW,ch/RH);
  const s=base*VIEW.zoom;
  return {s, x:cw/2-VIEW.cx*s, y:ch/2-VIEW.cy*s, w:RW*s, h:RH*s};
}
function clampView(cw,ch){
  const base=Math.min(cw/RW,ch/RH), s=base*VIEW.zoom;
  const hw=(cw/2)/s, hh=(ch/2)/s;
  VIEW.cx = hw>=RW/2 ? RW/2 : clamp(VIEW.cx,hw,RW-hw);
  VIEW.cy = hh>=RH/2 ? RH/2 : clamp(VIEW.cy,hh,RH-hh);
}
function zoomAt(px,py,cw,ch,factor){
  const v=mapView(cw,ch);
  const mx=(px-v.x)/v.s, my=(py-v.y)/v.s;
  VIEW.zoom=clamp(VIEW.zoom*factor,1,12);
  const base=Math.min(cw/RW,ch/RH), s2=base*VIEW.zoom;
  VIEW.cx=(cw/2-px)/s2+mx;
  VIEW.cy=(ch/2-py)/s2+my;
  clampView(cw,ch);
}
function resetView(){
  VIEW.zoom=1; VIEW.cx=RW/2; VIEW.cy=RH/2;
}

function drawMap(){
  if(!mapCv||!S) return;
  const cw=mapCv.width/dpr, ch=mapCv.height/dpr;
  mctx.setTransform(dpr,0,0,dpr,0,0);
  mctx.clearRect(0,0,cw,ch);
  if(bakeDirty){ bake(); bakeDirty=false; }
  const v=mapView(cw,ch);
  mctx.imageSmoothingEnabled=true;
  if("imageSmoothingQuality" in mctx) mctx.imageSmoothingQuality="high";
  mctx.drawImage(bakeCv,v.x,v.y,v.w,v.h);

  const pat=mctx.createPattern(getTexture(),"repeat");
  if(pat){
    mctx.save();
    mctx.globalCompositeOperation="overlay";
    mctx.globalAlpha=0.35;
    mctx.fillStyle=pat;
    mctx.fillRect(v.x,v.y,v.w,v.h);
    mctx.restore();
  }

  const vg=mctx.createRadialGradient(cw/2,ch/2,Math.min(cw,ch)*0.34,cw/2,ch/2,Math.max(cw,ch)*0.8);
  vg.addColorStop(0,"rgba(0,0,0,0)");
  vg.addColorStop(1,"rgba(3,7,10,0.62)");
  mctx.fillStyle=vg;
  mctx.fillRect(0,0,cw,ch);

  if(ovDirty) rebuildOverlay();
  mctx.drawImage(ovCv,v.x,v.y,v.w,v.h);

  const used=[];
  const flagRects=[];
  const visible=(x,y)=>x>v.x-40&&x<v.x+v.w+40&&y>v.y-20&&y<v.y+v.h+20;
  const tryLabel=(x,y,text,size,color)=>{
    const w=text.length*size*0.56;
    for(const u of used){ if(Math.abs(u.x-x)<(u.w+w)/2+6&&Math.abs(u.y-y)<(u.h+size)/2+4) return; }
    for(const f of flagRects){ if(Math.abs(f.x-x)<(f.w+w)/2+4&&Math.abs(f.y-y)<(f.h+size*0.55)/2+4) return; }
    used.push({x,y,w,h:size});
    mctx.font="600 "+size+"px Segoe UI,sans-serif";
    mctx.textAlign="center";
    mctx.textBaseline="middle";
    mctx.lineWidth=3;
    mctx.strokeStyle="rgba(6,10,14,0.62)";
    mctx.strokeText(text,x,y);
    mctx.fillStyle=color;
    mctx.fillText(text,x,y);
  };

  const fw=Math.min(26,9+VIEW.zoom*2.4), fh=fw*0.68;
  const flagPts=[];
  for(const n of S.nations){
    const cap=G.provs[n.capital];
    if(!cap) continue;
    const x=v.x+cap.x*v.s, y=v.y+cap.y*v.s;
    if(!visible(x,y)) continue;
    flagPts.push({n,x,y});
    flagRects.push({x,y,w:fw,h:fh});
  }

  for(const n of S.nations){
    if(n.isRebel) continue;
    const pri=n.id===S.playerId?2:(isWar(S.playerId,n.id)?1:0);
    if(pri===0&&VIEW.zoom<1.6) continue;
    for(const a of n.armies){
      const pr=G.provs[a.loc];
      const x=v.x+pr.x*v.s, y=v.y+pr.y*v.s;
      if(!visible(x,y)) continue;
      const rad=(pri===2?9:(pri===1?7:5.5))+Math.min(4,VIEW.zoom*0.8);
      flagRects.push({x,y,w:rad*2,h:rad*2});
    }
  }
  const showProv=VIEW.zoom>=1.9;
  if(!showProv){
    for(const f of flagPts){
      if(f.n.isRebel) continue;
      tryLabel(f.x, f.y+fh/2+13, f.n.name, 11, "#f2e9d2");
    }
  }else{
    for(const pr of G.provs){
      if(pr.area<26) continue;
      const x=v.x+pr.x*v.s, y=v.y+pr.y*v.s;
      if(!visible(x,y)) continue;
      tryLabel(x,y,pr.name,10,"#f0e9d9");
    }
  }

  for(const f of flagPts){
    const fc=flagCanvas(f.n);
    mctx.drawImage(fc,f.x-fw/2,f.y-fh/2,fw,fh);
    mctx.strokeStyle="rgba(0,0,0,.65)";
    mctx.lineWidth=1;
    mctx.strokeRect(f.x-fw/2,f.y-fh/2,fw,fh);
  }
  if(VIEW.zoom>=1.8&&G.seaZones){
    for(const n of S.nations){
      if(!n.fleet||n.dead||!(n.ships>0)) continue;
      const zs=G.seaZones;
      const zx2=n.fleet.z%zs.cols, zy2=Math.floor(n.fleet.z/zs.cols);
      const x=v.x+(zx2+0.5)*200*v.s, y=v.y+(zy2+0.5)*200*v.s;
      if(!visible(x,y)) continue;
      const r=5+Math.min(4,VIEW.zoom);
      mctx.beginPath();
      mctx.arc(x,y,r,0,Math.PI*2);
      mctx.fillStyle=n.color;
      mctx.fill();
      mctx.lineWidth=1;
      mctx.strokeStyle="rgba(6,10,13,.85)";
      mctx.stroke();
      mctx.fillStyle="#e8f0f6";
      mctx.font="700 "+(r>7?10:8)+"px Segoe UI,sans-serif";
      mctx.textAlign="center";
      mctx.textBaseline="middle";
      mctx.fillText("⚓",x,y+0.5);
    }
  }

  const marks=[];
  for(const n of S.nations){
    if(n.isRebel) continue;
    const pri=n.id===S.playerId?2:(isWar(S.playerId,n.id)?1:0);
    for(const a of n.armies) marks.push({n,a,pri});
  }
  marks.sort((p,q)=>p.pri-q.pri);
  for(const m of marks){
    if(m.pri===0&&VIEW.zoom<1.6) continue;
    const n=m.n, a=m.a;
    const pr=G.provs[a.loc];
    const x=v.x+pr.x*v.s, y=v.y+pr.y*v.s;
    if(!visible(x,y)) continue;
    const rad=(m.pri===2?9:(m.pri===1?7:5.5))+Math.min(4,VIEW.zoom*0.8);
    mctx.beginPath();
    mctx.moveTo(x-rad*0.8,y+rad*0.55);
    mctx.lineTo(x,y+rad*1.5);
    mctx.lineTo(x+rad*0.8,y+rad*0.55);
    mctx.closePath();
    mctx.fillStyle=n.color;
    mctx.fill();
    mctx.strokeStyle="rgba(6,10,13,.85)";
    mctx.lineWidth=1;
    mctx.stroke();
    mctx.beginPath();
    mctx.arc(x,y,rad,0,Math.PI*2);
    mctx.fillStyle=n.color;
    mctx.fill();
    mctx.lineWidth=m.pri===2?2.2:1.2;
    mctx.strokeStyle=m.pri===2?"#f6ead0":"rgba(6,10,13,.9)";
    mctx.stroke();
    if(rad>6){
      mctx.fillStyle="#fff";
      mctx.font="700 "+(rad>9?10:9)+"px Segoe UI,sans-serif";
      mctx.textAlign="center";
      mctx.textBaseline="middle";
      mctx.fillText(String(a.units),x,y+0.5);
    }
  }

  const sel=S.sel.prov;
  if(sel!=null){
    const pr=G.provs[sel];
    const x=v.x+pr.x*v.s, y=v.y+pr.y*v.s;
    mctx.font="600 12px Segoe UI,sans-serif";
    mctx.textAlign="center";
    mctx.textBaseline="bottom";
    const w=mctx.measureText(pr.name).width;
    mctx.fillStyle="rgba(8,13,17,.85)";
    mctx.fillRect(x-w/2-7,y-30,w+14,18);
    mctx.strokeStyle="rgba(217,181,102,.6)";
    mctx.lineWidth=1;
    mctx.strokeRect(x-w/2-7,y-30,w+14,18);
    mctx.fillStyle="#eadfc4";
    mctx.fillText(pr.name,x,y-15);
  }

  if(S.sel.army!=null){
    const sf=findArmy(S.sel.army);
    if(sf&&sf.nation.id===S.playerId){
      const pr0=G.provs[sf.army.loc];
      const ax0=v.x+pr0.x*v.s, ay0=v.y+pr0.y*v.s;
      mctx.beginPath(); mctx.arc(ax0,ay0,14,0,Math.PI*2);
      mctx.strokeStyle="rgba(246,234,208,.9)"; mctx.lineWidth=2; mctx.setLineDash([4,3]); mctx.stroke(); mctx.setLineDash([]);
      for(const nb of G.adj[sf.army.loc]){
        const gp=G.provs[nb];
        const bx=v.x+gp.x*v.s, by=v.y+gp.y*v.s;
        mctx.beginPath(); mctx.arc(bx,by,9,0,Math.PI*2);
        mctx.strokeStyle="rgba(160,220,180,.5)"; mctx.lineWidth=1.5; mctx.stroke();
      }
      if(sf.army.moves>0){
        const txt="Армия: "+sf.army.units+" п. · мораль "+Math.round(sf.army.morale||0)+"% · снабжение "+Math.round(sf.army.supply||0)+"% — щёлкните соседнюю провинцию";
        mctx.font="600 12px Segoe UI,sans-serif";
        mctx.textAlign="center"; mctx.textBaseline="bottom";
        const tw=mctx.measureText(txt).width;
        mctx.fillStyle="rgba(8,13,17,.82)";
        mctx.fillRect(cw/2-tw/2-10,ch-36,tw+20,24);
        mctx.strokeStyle="rgba(217,181,102,.5)"; mctx.lineWidth=1;
        mctx.strokeRect(cw/2-tw/2-10,ch-36,tw+20,24);
        mctx.fillStyle="#eadfc4";
        mctx.fillText(txt,cw/2,ch-16);
      }
    }
  }

  mctx.font="600 11px Segoe UI,sans-serif";
  mctx.textAlign="left";
  mctx.textBaseline="top";
  mctx.fillStyle="rgba(220,230,238,.75)";
  mctx.fillText("×"+VIEW.zoom.toFixed(1),v.x+8,v.y+6);
}

function updateTop(){
  if(!S) return;
  const P=S.nations[S.playerId];
  const inc=nationIncome(P), up=upkeep(P);
  document.getElementById("s-date").textContent=dateStr();
  document.getElementById("s-pause").textContent=S.speed===0?"пауза":"идёт время";
  document.getElementById("s-gold").textContent=Math.floor(P.gold)+" ⚜";
  const net=inc-up;
  const netEl=document.getElementById("s-net");
  netEl.textContent=(net>=0?"+":"")+fmt1(net)+" в месяц";
  netEl.style.color=net>=0?"#7fc187":"#de7a6c";
  document.getElementById("s-inc").textContent=fmt1(inc);
  document.getElementById("s-upk").textContent="содержание "+fmt1(up);
  document.getElementById("s-man").textContent=Math.floor(P.manpower);
  document.getElementById("s-manmax").textContent="из "+maxManpower(P);
  document.getElementById("s-stab").textContent=Math.round(P.stability)+"%";
