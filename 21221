function removeArmy(n,a){
  if(a.gen){
    if(Math.random()<0.35) logMsg("Генерал "+a.gen.name+" погиб вместе с армией","war");
    else n.generals.push(a.gen);
    a.gen=null;
  }
  const i=n.armies.indexOf(a);
  if(i>=0) n.armies.splice(i,1);
}
function canAfford(v){return S.nations[S.playerId].gold>=v;}

function buildIn(provId,key){
  const P=S.nations[S.playerId], d=S.provs[provId], b=BUILD[key];
  if(d.owner!==P.id) return toast("Это чужая страна");
  if(d.occupiedBy!=null) return toast("Страна оккупирована");
  if(d.build) return toast("В провинции уже идёт стройка");
  const slots=Object.values(d.b).reduce((a,c)=>a+c,0);
  if(slots>=5) return toast("В провинции уже 5 построек");
  const cost=buildCost(P,b);
  if(P.gold<cost) return toast("Не хватает золота: нужно "+cost);
  P.gold-=cost;
  d.build={key, left:2+Math.round(b.cost/45)};
  logMsg("Начато строительство: "+b.n+" в "+G.provs[provId].name,"gold");
  renderPanel(); updateTop();
}
function assault(provId){
  const P=S.nations[S.playerId], d=S.provs[provId];
  const here=armiesAt(provId).filter(h=>h.nation.id===P.id);
  if(!here.length) return toast("Здесь нет вашей армии");
  if(d.owner===P.id) return toast("Это ваша провинция");
  if(!isWar(P.id,d.owner)) return toast("Сначала объявите войну");
  const a=here[0].army;
  const loss=Math.max(1,Math.round(a.units*(0.12+Math.random()*0.18)));
  a.units=Math.max(0,a.units-loss);
  d.siege=clamp((d.siege||0)+35+Math.random()*30,0,100);
  logMsg("Штурм "+G.provs[provId].name+": потери "+loss+", осада "+Math.round(d.siege)+"%","war");
  if(a.units<=0) removeArmy(P,a);
  if(d.siege>=100) occupy(provId,P.id,false);
  bakeDirty=true; renderPanel(); updateTop();
}
function pacifyProv(provId){
  const P=S.nations[S.playerId], d=S.provs[provId];
  if(d.owner!==P.id) return toast("Это чужая провинция");
  if(P.gold<25) return toast("Нужно 25 золота");
  P.gold-=25;
  d.unrest=Math.max(0,(d.unrest||0)-40);
