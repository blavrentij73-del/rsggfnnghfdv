function saveGame(){
  if(!S) return;
  try{
    const data={
      v:1, seed:S.seed, date:S.date, playerId:S.playerId, nextArmy:S.nextArmy,
      provs:S.provs.map(d=>({owner:d.owner,dev:d.dev,b:d.b,build:d.build,siege:d.siege,occupiedBy:d.occupiedBy,unrest:d.unrest,rebel:!!d.rebel})),
      nations:S.nations.map(n=>({gold:n.gold,stability:n.stability,prestige:n.prestige,manpower:n.manpower,armies:n.armies,allies:n.allies,dead:!!n.dead,tech:n.tech,rp:n.rp,generals:n.generals,ships:n.ships,port:n.port})),
      wars:S.wars, truces:S.truces, rel:S.rel, log:S.log, ended:S.ended, stats:S.stats
    };
    localStorage.setItem("derzhavy_save", JSON.stringify(data));
  }catch(e){}
}
